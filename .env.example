# Frontend: public Supabase URL/key only. Never expose service-role or Stripe secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set true only after configuring an organization SAML connection in Supabase.
NEXT_PUBLIC_ENABLE_SSO=false
# Canonical frontend origin, for example https://your-app.vercel.app
APP_URL=http://localhost:3000
# Vercel service binding supplies this in production.
GO_API_URL=http://localhost:8080

# Server-only billing, usage recording and administrator reporting
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Active INR recurring prices: 49900 paise/month and 399900 paise/year.
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
# Comma-separated verified Supabase user UUIDs. No implicit admin or unpaid lab bypass.
ADMIN_USER_IDS=

# Go service: uses each learner's bearer token and database RLS
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PORT=8080

# Server-only Vercel Sandbox runtime snapshot. Prepare with npm run sandbox:prepare.
SANDBOX_SNAPSHOT_ID=
# Migration connection string; never expose to the browser.
POSTGRES_URL=

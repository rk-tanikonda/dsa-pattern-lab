# Next.js: Supabase project settings > API. Use the publishable/anon key, never service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Go API origin; localhost is only for development. Use an HTTPS service URL in production.
GO_API_URL=http://localhost:8080

# Go backend (set these on the Go hosting service)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PORT=8080
# Dedicated, sandboxed Judge0 CE instance. No code is executed on this server.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
# Override IDs to match GET /languages on your Judge0 deployment.
JUDGE0_GO_ID=60
JUDGE0_PYTHON_ID=71
JUDGE0_JAVASCRIPT_ID=63

{
  ".go": {"compile": ["go", "build", "-o", "{exe}", "{source}"], "run": ["{exe}"]},
  ".c": {"compile": ["cc", "-std=c11", "-Wall", "-Wextra", "{source}", "-o", "{exe}"], "run": ["{exe}"]},
  ".cpp": {"compile": ["c++", "-std=c++17", "-Wall", "-Wextra", "{source}", "-o", "{exe}"], "run": ["{exe}"]},
  ".py": {"run": ["python3", "{source}"]},
  ".js": {"run": ["node", "{source}"]},
  ".ts": {"run": ["tsx", "{source}"]},
  ".java": {"compile": ["javac", "-d", "{build}", "{source}"], "run": ["java", "-cp", "{build}", "{stem}"]},
  ".rs": {"compile": ["rustc", "{source}", "-o", "{exe}"], "run": ["{exe}"]},
  ".swift": {"compile": ["swiftc", "{source}", "-o", "{exe}"], "run": ["{exe}"]},
  ".kt": {"compile": ["kotlinc", "{source}", "-include-runtime", "-d", "{build}/solution.jar"], "run": ["java", "-jar", "{build}/solution.jar"]},
  ".rb": {"run": ["ruby", "{source}"]},
  ".php": {"run": ["php", "{source}"]},
  ".lua": {"run": ["lua", "{source}"]},
  ".pl": {"run": ["perl", "{source}"]},
  ".r": {"run": ["Rscript", "{source}"]},
  ".dart": {"run": ["dart", "run", "{source}"]},
  ".hs": {"run": ["runghc", "{source}"]},
  ".sh": {"run": ["bash", "{source}"]}
}
